# scripts/.env.example
# このファイルをコピーして scripts/.env を作る:
#   cp scripts/.env.example scripts/.env
# 実際の値を埋める。.env は .gitignore で除外済み

# --- Discord通知 (一方向: スクリプト→Discord) ---
# Discord サーバー → チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXX/XXXXX

# --- Discord Bot (双方向: スマホ→Threads 指示出し用) ---
# https://discord.com/developers/applications で Application 作成 → Bot 化
# 詳しい手順は SETUP.md の「Discord Bot セットアップ」セクション参照
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# 自分の Discord User ID (開発者モード ON で自分を右クリック → ユーザー ID コピー)
DISCORD_OWNER_ID=YOUR_USER_ID_HERE
# 招待先サーバーの ID (サーバーアイコン右クリック → サーバー ID コピー)
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE
# DM ではなくチャンネルに通知したい場合のチャンネル ID (空ならオーナーへ DM)
DISCORD_REVIEW_CHANNEL_ID=

# --- Threads API (Meta) ---
# https://developers.facebook.com/docs/threads
# Meta Developer登録 → アプリ作成 → Threads API追加 → 長期アクセストークン取得
THREADS_USER_ID=YOUR_THREADS_USER_ID
THREADS_ACCESS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN

# 複数アカウント用（必要なら追加）
THREADS_USER_ID_GAKU_AI_LIFE=
THREADS_ACCESS_TOKEN_GAKU_AI_LIFE=
THREADS_USER_ID_IMOZO_NOTE=
THREADS_ACCESS_TOKEN_IMOZO_NOTE=

# --- Claude Code 実行パス ---
# 通常は claude で OK。フルパスが必要なら指定
CLAUDE_CMD=claude
