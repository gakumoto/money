# GitHubのPersonal Access Token（Settings > Developer settings > PAT > Fine-grained tokens）
# 権限: Contents: Read and Write （/review からの承認/却下で write が必要）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHubのリポジトリ（owner/repo-name の形式）
GITHUB_REPO=your-username/your-private-repo

# /review ページの認証パスワード（/review と /api/login で使用）
# 未設定だと middleware が無効化されて誰でも /review に入れるので必ず設定する
DASHBOARD_PASSWORD=set-a-strong-password
